# HTTPS для Avtodom в облаке. setup.sh подставляет домен и пишет /etc/caddy/Caddyfile.
# Сертификат Let's Encrypt Caddy получает и продлевает сам: нужна запись A домена на адрес
# сервера и открытые порты 80 и 443.
{
	email __EMAIL__
}

__DOMAIN__ {
	encode gzip
	# Входящий X-Forwarded-For от клиента Caddy отбрасывает и ставит настоящий адрес — по нему
	# сервер считает неудачные входы (ADR-128). Сервер слушает только 127.0.0.1.
	reverse_proxy 127.0.0.1:8080
	header Strict-Transport-Security "max-age=31536000"
	log {
		output file /var/log/caddy/avtodom.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

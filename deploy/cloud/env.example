# Настройки сервера Avtodom в облаке: файл /etc/avtodom/env (владелец root, права 600).
# setup.sh создаёт его из этого образца и сам вписывает DATABASE_URL (пароль базы генерируется)
# и PUBLIC_URL. Ключи вписываются только на сервере, в git — никогда (I19).
# Формат — EnvironmentFile systemd: ИМЯ=значение, без кавычек и без `export`; пустое значение —
# функция выключена. После правки: systemctl restart avtodom.
# BIND_ADDR и WEB_DIR сюда НЕ вписывать: их задаёт avtodom.service (127.0.0.1:8080 и
# /opt/avtodom/web), а строка из этого файла перекрыла бы службу — сервер открылся бы в обход Caddy
# или без клиента. setup.sh такие строки закомментирует и предупредит.

# Подключение к базе (обязательно). Пишет setup.sh: postgres://avtodom:<пароль>@127.0.0.1:5432/avtodom
DATABASE_URL=

# Cookie входа только по HTTPS. За Caddy — всегда true.
COOKIE_SECURE=true

# Внешний адрес программы (https://домен) — ссылка на кабинет юрлица в сообщениях о закупе.
PUBLIC_URL=

# Первый вход владельца — действует, только пока в базе нет пользователей. При переносе базы
# с Мака пользователи уже есть: оставить пустыми.
BOOTSTRAP_OWNER_LOGIN=
BOOTSTRAP_OWNER_PASSWORD=

# Ключ Телеграм-бота от @BotFather (ADR-050). Бот работает только на ОДНОМ сервере: здесь ключ
# вписывается в день переезда, а на Маке сервер с ключом больше не запускается.
TELEGRAM_BOT_TOKEN=
# Адрес API Телеграма — только для проверок. Пустой строкой НЕ задавать (сервер возьмёт пустой
# адрес): без строки — https://api.telegram.org.
#TELEGRAM_API_BASE=

# Сервис разбора вопросов боту текстом и накладных по фото (SPEC-21, SPEC-30 §9).
ASSISTANT_API_KEY=
# Модель вопросов, модель накладных по фото и адрес сервиса; пусто — значения по умолчанию.
ASSISTANT_MODEL=
ASSISTANT_INVOICE_MODEL=
ASSISTANT_API_URL=
# Вопросов в сутки на филиал; пусто — 100.
ASSISTANT_DAILY_LIMIT=

# Банк Optima Business (SPEC-31): QR на сумму чека и сверка с выпиской; пусто — выключено.
OPTIMA_API_KEY=
# Адрес API банка; пусто — https://api.optimabusiness.kg.
OPTIMA_API_URL=

# WhatsApp Business Platform (SPEC-32): постоянный ключ и ID номера; без обоих WhatsApp выключен.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Адрес Graph API; пусто — версия по умолчанию.
WHATSAPP_API_URL=

# Адрес клиента для предела попыток входа (ADR-092, ADR-128). Caddy на этом же сервере ходит
# с 127.0.0.1 и сам ставит X-Forwarded-For — сервер уже берёт адрес оттуда. Оба значения
# оставить пустыми: TRUSTED_PROXIES — только для прокси на другом адресе (через запятую),
# TRUST_CF_HEADER=1 — только за туннелем Cloudflare.
TRUSTED_PROXIES=
TRUST_CF_HEADER=

# Журнал: info — обычный, debug — подробный (journalctl -u avtodom).
RUST_LOG=info

  "query": "select o.name, o.barcode, o.product_id, umag_key(o.barcode, o.name) as \"key!\",\n                  p.name as \"linked_name?\"\n           from old_catalog o left join products p on p.id = o.product_id\n           where o.id = $1 and o.branch_id = $2\n           for update of o",

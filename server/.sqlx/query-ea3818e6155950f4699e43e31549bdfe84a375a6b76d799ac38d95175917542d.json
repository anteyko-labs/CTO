  "query": "select coalesce(c.book_slot, case c.kind when 'oil' then 'oil' when 'filter' then 'oil_filter' else 'none' end) as \"book_slot!\", c.book_interval_km, c.book_interval_days,\n                  c.kind, c.name, c.points_mode, c.points_value, c.attributes,\n                  category_by_type(c.attributes) as \"by_type!\"\n           from categories c where c.id = $1 for update",

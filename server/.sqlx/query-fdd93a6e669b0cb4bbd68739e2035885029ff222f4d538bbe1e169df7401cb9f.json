{
  "db_name": "PostgreSQL",
  "query": "select r.id, r.number, r.category_id, c.name as \"category_name?\", r.status, r.comment,\n                  u.full_name as user_name, r.created_at, r.posted_at,\n                  (select count(*) from revision_lines l where l.revision_id = r.id) as \"counted!\"\n           from revisions r\n           join users u on u.id = r.user_id\n           left join categories c on c.id = r.category_id\n           where r.branch_id = $1\n           order by r.created_at desc limit 100",

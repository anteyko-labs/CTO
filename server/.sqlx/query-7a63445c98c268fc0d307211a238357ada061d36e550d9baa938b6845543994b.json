{
  "db_name": "PostgreSQL",
  "query": "select c.id, c.name, c.kind, c.attributes, coalesce(c.book_slot, case c.kind when 'oil' then 'oil' when 'filter' then 'oil_filter' else 'none' end) as \"book_slot!\",\n                  c.book_interval_km, c.book_interval_days, c.archived\n           from categories c where $1 or not c.archived order by c.archived, c.name",

  "query": "select d.created_at, d.status, d.recognized, r.number as \"receipt_number?\"\n           from receipt_drafts x\n           join receipt_drafts d on d.id = coalesce(x.parent_id, x.id)\n           left join receipts r on r.id = d.receipt_id\n           where x.id = $1",

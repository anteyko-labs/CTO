{
  "db_name": "PostgreSQL",
  "query": "select a.id, a.action, a.data, a.entity_id, a.created_at, u.full_name as \"user_name?\"\n           from audit_log a\n           left join users u on u.id = a.user_id\n           where a.branch_id = $1 and a.action = any($2)\n           order by a.created_at desc, a.id desc\n           limit $3 offset $4",

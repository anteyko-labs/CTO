{
  "db_name": "PostgreSQL",
  "query": "select p.name, c.kind as cat, l.kind, l.qty, p.container_ml\n           from sale_lines l\n           join products p on p.id = l.product_id\n           join categories c on c.id = p.category_id\n           where l.sale_id = $1 and not l.gift and c.kind in ('oil', 'filter')\n           order by l.line_no",

  "query": "select r.trigger_product_id, r.min_units, i.gift_product_id, i.gift_qty, r.active\n               from gift_rules r join gift_rule_items i on i.rule_id = r.id\n               where (r.active or $3)\n                 and r.trigger_product_id = any($1) and i.gift_product_id = any($2)",

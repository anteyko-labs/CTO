  "query": "select id, branch_id, full_name, is_cashier, is_master from employees\n           where active and length(regexp_replace(phone, '[^0-9]', '', 'g')) >= 9\n             and right(regexp_replace(phone, '[^0-9]', '', 'g'), 9) = $1\n           order by created_at",

  "query": "select c.id, c.name, c.kind, c.attributes, coalesce(c.book_slot, case c.kind when 'oil' then 'oil' when 'filter' then 'oil_filter' else 'none' end) as \"book_slot!\",\n                  c.book_interval_km, c.book_interval_days, category_by_type(c.attributes) as \"by_type!\"\n           from categories c order by c.name",

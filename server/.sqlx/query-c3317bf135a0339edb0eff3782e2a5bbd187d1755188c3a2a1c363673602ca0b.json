  "query": "select p.name, p.unit, p.container_ml, p.archived, coalesce(bp.sale_price_tyiyn, 0) as \"sale_price!\"\n           from products p left join branch_products bp on bp.product_id = p.id and bp.branch_id = $2\n           where p.id = $1\n           for key share of p",
